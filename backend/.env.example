# Server
# Note: Docker Desktop occupies :8080 by default on macOS, so we use :8081.
PORT=8081
ENV=development

# Postgres
DATABASE_URL=postgres://medimap:medimap_dev@localhost:5432/medimap?sslmode=disable

# JWT (change in production)
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_TTL_HOURS=24

# CORS
CORS_ORIGIN=http://localhost:3000
